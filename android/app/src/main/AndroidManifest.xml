<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- local HTTP endpoint (127.0.0.1:17590 by default) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- glucose alerts: repeat on time, vibrate, show over the lock screen, set the alert volume -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- critical alerts: may turn Do Not Disturb from total silence to alarms only (if you allow it) -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- the alarm screen straight up while the phone is in use (if you allow it) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- package visibility (API 30+): only to show whether the Eversense app is installed -->
    <queries>
        <package android:name="com.senseonics.eversense365.us" />
        <package android:name="com.senseonics.gen12androidapp" />
        <package android:name="com.senseonics.androidapp" />
    </queries>

    <application
        android:name=".BridgeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Meanwhile, shown in a WebView. Handles its own configuration changes so a
             rotation or dark-mode switch doesn't reload the page. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/WebTheme"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- press and hold the app icon: Glucose alerts -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- The bridge's status and setup screen. Exported so the emulator test can run
             its self-test and log export. -->
        <activity
            android:name=".StatusActivity"
            android:exported="true"
            android:launchMode="singleTop" />

        <!-- The alarm: shown over everything and the lock screen while a glucose alert sounds. -->
        <activity
            android:name=".AlertScreenActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:taskAffinity="app.meanwhile.bridge.alarm"
            android:turnScreenOn="true" />

        <!-- The emulator test's alert controls: they do nothing without the adb-only token. -->
        <receiver
            android:name=".AutomationReceiver"
            android:exported="true" />

        <receiver
            android:name=".AlertReceiver"
            android:exported="false" />

        <!-- Same mechanism as xDrip+ "Companion App" mode (services/UiBasedCollector) -->
        <service
            android:name=".EversenseListenerService"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <!-- Eversense's glucose notification is ongoing: make sure that type is delivered -->
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="ongoing|alerting|silent|conversations" />
        </service>

        <service
            android:name=".BridgeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a localhost-only glucose data endpoint and notification capture alive for a personal diabetes app" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
