<?xml version="1.0" encoding="utf-8"?>
<!-- Press and hold the app icon: straight to the glucose alerts. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="glucose_alerts"
        android:shortcutLongLabel="@string/shortcut_alerts"
        android:shortcutShortLabel="@string/shortcut_alerts">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="app.meanwhile.bridge.AlertsActivity"
            android:targetPackage="app.meanwhile.bridge" />
    </shortcut>
</shortcuts>
