<?xml version="1.0" encoding="utf-8"?>
<!-- Press and hold the app icon: the Alerts tab. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="glucose_alerts"
        android:shortcutLongLabel="@string/shortcut_alerts"
        android:shortcutShortLabel="@string/shortcut_alerts">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="app.meanwhile.bridge.MainActivity"
            android:targetPackage="app.meanwhile.bridge">
            <extra
                android:name="page"
                android:value="alerts/" />
        </intent>
    </shortcut>
</shortcuts>
